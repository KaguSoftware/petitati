# ---- Supabase (from `npx supabase status` locally, or the client's project settings) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Tenancy ----
# Root domain used for subdomain resolution (store.<ROOT_DOMAIN>). Use localhost:3000 in dev.
ROOT_DOMAIN=localhost:3000
# Store served when no subdomain / custom domain / path prefix matches.
DEFAULT_STORE_SLUG=default

# ---- Email (optional; without it emails are logged to the console) ----
RESEND_API_KEY=
EMAIL_FROM_FALLBACK=noreply@example.com

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Supplier import / sync (scripts/zoo) ----
# Shared secret the import scripts send to POST /api/internal/revalidate-catalog. Unset = endpoint off.
CATALOG_REVALIDATE_SECRET=
# Only the scripts read this (Claude API, product translation tr → en/fa). Never needed by the app.
ANTHROPIC_API_KEY=
