# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# owner drops: spreadsheets/photos handed over for catalog imports. Kept locally as the
# source of record for a migration, never committed. Safe to delete once imported.
/*.xlsx
/PHOTO-*.jpg
/PHOTO-*.jpeg

# supplier import cache (scripts/zoo): crawled pages, groupings, translations
/.data/

# hyperframes snapshot output (regenerated on demand)
brag-*/composition/snapshots/
